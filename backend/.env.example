# Start the bundled local model before enabling chat.
LOCAL_AI_ENABLED=true
LOCAL_AI_URL=http://127.0.0.1:8090
LOCAL_AI_MODEL=soc-brain
# Optional. Keep this value in the backend environment only.
LOCAL_AI_API_KEY=
# Optional OpenAI-compatible provider can be configured in the dashboard AI settings.
# Without an API key, the bundled local model is used.
# Required to authenticate decoy collector and webhook requests.
API_KEY=CHANGE_ME
# Configure all three Zabbix values when ZABBIX_URL is set.
ZABBIX_URL=
ZABBIX_USER=CHANGE_ME
ZABBIX_PASS=CHANGE_ME
# Required only when the corresponding missing credentials need initialization.
ADMIN_PANEL_PASSWORD=CHANGE_ME
INITIAL_ADMIN_PASSWORD=CHANGE_ME
INITIAL_ANALYST_PASSWORD=CHANGE_ME
INITIAL_VIEWER_PASSWORD=CHANGE_ME
# Demo login fallback stays disabled unless explicitly enabled.
DEMO_CREDENTIALS=false
DEMO_ADMIN_PASSWORD=CHANGE_ME
DEMO_ANALYST_PASSWORD=CHANGE_ME
DEMO_VIEWER_PASSWORD=CHANGE_ME
